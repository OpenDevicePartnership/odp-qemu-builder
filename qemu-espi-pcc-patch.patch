diff --git a/hw/odp/espi-controller.c b/hw/odp/espi-controller.c
new file mode 100644
index 0000000000..c0d4f2c9f7
--- /dev/null
+++ b/hw/odp/espi-controller.c
@@ -0,0 +1,936 @@
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "chardev/char-fe.h"
+#include "exec/address-spaces.h"
+#include "hw/core/cpu.h"
+#include "hw/irq.h"
+#include "hw/odp/espi-controller.h"
+#include "hw/odp/espi-proto.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "migration/vmstate.h"
+#include "system/cpus.h"
+
+#define ESPI_DATA_WINDOW_COUNT 2
+#define ESPI_WINDOW_COUNT      (ESPI_DATA_WINDOW_COUNT + 1)
+#define ESPI_WINDOW_SIZE       0x1000
+#define ESPI_CONTROL_STATUS    0x00
+#define ESPI_CONTROL_DOORBELL  0x04
+#define ESPI_CONTROL_IRQ_ACK   0x0c
+#define ESPI_MAX_PAYLOAD       64
+#define ESPI_RESPONSE_MODIFIER (1U << 30)
+
+#define ESPI_ERROR_TIMEOUT    (1U << 0)
+#define ESPI_ERROR_CRC        (1U << 1)
+#define ESPI_ERROR_PROTOCOL   (1U << 2)
+#define ESPI_ERROR_LINK       (1U << 3)
+#define ESPI_ERROR_COMPLETION (1U << 4)
+#define ESPI_ERROR_WINDOW     (1U << 5)
+
+typedef struct OdpESPIWindow {
+    MemoryRegion iomem;
+    OdpESPIControllerState *controller;
+    uint32_t base;
+    uint32_t size;
+    bool enabled;
+    bool mapped;
+} OdpESPIWindow;
+
+struct OdpESPIControllerState {
+    SysBusDevice parent_obj;
+    CharBackend chr;
+    qemu_irq irq[ODP_ESPI_IRQ_COUNT];
+    OdpESPIWindow windows[ESPI_WINDOW_COUNT];
+    uint32_t errors;
+    uint32_t irq_level;
+    unsigned vwire_limit;
+    bool vwire_supported;
+    bool vwire_ready;
+    bool connected;
+    bool ready;
+    bool configured;
+    bool reset_needed;
+    bool crc_enabled;
+    bool busy;
+    bool failed;
+    bool pending;
+    bool expect_response;
+    bool receiving;
+    bool alert;
+    uint8_t command;
+    uint8_t tag;
+    uint16_t target_status;
+    uint8_t tx[ESPI_MAX_PAYLOAD + 16];
+    unsigned tx_size;
+    unsigned tx_pos;
+    uint8_t rx[ODP_ESPI_VWIRE_MAX_PACKET_SIZE + 4];
+    unsigned rx_size;
+    unsigned rx_needed;
+    uint32_t timeout_ms;
+    guint write_watch;
+    guint service_source;
+    QemuCond cond;
+};
+
+static void odp_espi_schedule_service(OdpESPIControllerState *s);
+static bool odp_espi_drain_vwires(OdpESPIControllerState *state,
+                                  int64_t deadline);
+
+static void odp_espi_update_irq(OdpESPIControllerState *state)
+{
+    unsigned index;
+
+    for (index = 0; index < ODP_ESPI_IRQ_COUNT; index++) {
+        bool level = (state->irq_level & (1U << index)) != 0;
+
+        qemu_set_irq(state->irq[index], level);
+    }
+}
+
+static void odp_espi_clear_vwires(OdpESPIControllerState *state)
+{
+    state->irq_level = 0;
+    state->vwire_ready = false;
+    state->target_status = 0;
+    state->alert = false;
+    odp_espi_update_irq(state);
+}
+
+static int64_t odp_espi_now_ms(void)
+{
+    return g_get_monotonic_time() / 1000;
+}
+
+static uint8_t odp_espi_crc8(const uint8_t *data, size_t length)
+{
+    uint8_t crc = ODP_ESPI_CRC8_INIT;
+    size_t index;
+    unsigned bit;
+
+    for (index = 0; index < length; index++) {
+        crc ^= data[index];
+        for (bit = 0; bit < 8; bit++) {
+            crc = (crc << 1) ^ ((crc & 0x80) ? ODP_ESPI_CRC8_POLYNOMIAL : 0);
+        }
+    }
+    return crc;
+}
+
+static void odp_espi_set_error(OdpESPIControllerState *state, uint32_t error)
+{
+    state->errors |= error;
+}
+
+static void odp_espi_cancel(OdpESPIControllerState *s, uint32_t error)
+{
+    odp_espi_set_error(s, error);
+    s->failed = true;
+    s->pending = false;
+    s->ready = false;
+    s->configured = false;
+    s->receiving = false;
+    odp_espi_clear_vwires(s);
+    if (s->write_watch) {
+        g_source_remove(s->write_watch);
+        s->write_watch = 0;
+    }
+    qemu_cond_broadcast(&s->cond);
+}
+
+static void odp_espi_disconnect(OdpESPIControllerState *s, uint32_t error)
+{
+    odp_espi_cancel(s, error);
+    qemu_chr_fe_disconnect(&s->chr);
+}
+
+static gboolean odp_espi_wakeup(void *opaque)
+{
+    return G_SOURCE_REMOVE;
+}
+
+static bool odp_espi_wait(OdpESPIControllerState *s, int64_t deadline)
+{
+    int64_t remaining = deadline - odp_espi_now_ms();
+
+    if (remaining <= 0) {
+        odp_espi_disconnect(s, ESPI_ERROR_TIMEOUT);
+        return false;
+    }
+    if (qemu_in_vcpu_thread()) {
+        CPUState *cpu = current_cpu;
+        bool running = cpu->running;
+
+        if (running) {
+            cpu_exec_end(cpu);
+        }
+        process_queued_cpu_work(cpu);
+        qemu_cond_timedwait_bql(&s->cond, MIN(remaining, 10));
+        if (running) {
+            bql_unlock();
+            cpu_exec_start(cpu);
+            bql_lock();
+        }
+    } else {
+        GSource *source = g_timeout_source_new(MIN(remaining, 10));
+
+        g_source_set_callback(source, odp_espi_wakeup, NULL, NULL);
+        g_source_attach(source, NULL);
+        g_main_context_iteration(NULL, true);
+        g_source_destroy(source);
+        g_source_unref(source);
+    }
+    return !s->failed;
+}
+
+static gboolean odp_espi_writable(void *unused, GIOCondition condition,
+                                   void *opaque);
+
+static void odp_espi_flush(OdpESPIControllerState *s)
+{
+    int written;
+
+    written = qemu_chr_fe_write(&s->chr, s->tx + s->tx_pos,
+                                s->tx_size - s->tx_pos);
+    if (written < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+        odp_espi_disconnect(s, ESPI_ERROR_LINK);
+        return;
+    }
+    if (written > 0) {
+        s->tx_pos += written;
+    }
+    if (s->tx_pos < s->tx_size) {
+        s->write_watch = qemu_chr_fe_add_watch(&s->chr, G_IO_OUT | G_IO_HUP,
+                                               odp_espi_writable, s);
+        if (!s->write_watch) {
+            odp_espi_disconnect(s, ESPI_ERROR_LINK);
+        }
+    } else if (!s->expect_response) {
+        s->pending = false;
+        qemu_cond_broadcast(&s->cond);
+    }
+}
+
+static gboolean odp_espi_writable(void *unused, GIOCondition condition,
+                                   void *opaque)
+{
+    OdpESPIControllerState *s = opaque;
+
+    s->write_watch = 0;
+    if (condition & G_IO_HUP) {
+        odp_espi_disconnect(s, ESPI_ERROR_LINK);
+    } else {
+        odp_espi_flush(s);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static bool odp_espi_transmit(OdpESPIControllerState *s, unsigned size,
+                              bool response, int64_t deadline)
+{
+    if (!s->connected || s->failed) {
+        return false;
+    }
+    s->tx_size = size;
+    s->tx_pos = 0;
+    s->rx_size = 0;
+    s->rx_needed = 0;
+    s->receiving = false;
+    s->expect_response = response;
+    s->alert = false;
+    s->pending = true;
+    odp_espi_flush(s);
+    while (s->pending) {
+        if (!odp_espi_wait(s, deadline)) {
+            return false;
+        }
+    }
+    return !s->failed;
+}
+
+static bool odp_espi_exchange(OdpESPIControllerState *s, uint8_t command,
+                              const uint8_t *data, unsigned length,
+                              int64_t deadline)
+{
+    s->command = command;
+    s->tx[0] = ODP_ESPI_WIRE_DATA;
+    s->tx[1] = command;
+    if (length) {
+        memcpy(s->tx + 2, data, length);
+    }
+    s->tx[length + 2] = odp_espi_crc8(s->tx + 1, length + 1);
+    return odp_espi_transmit(s, length + 3, true, deadline);
+}
+
+static bool odp_espi_configuration(OdpESPIControllerState *s, uint16_t address,
+                                   uint32_t *value, bool write,
+                                   int64_t deadline)
+{
+    uint8_t data[6];
+
+    stw_be_p(data, address);
+    if (write) {
+        stl_le_p(data + 2, *value);
+    }
+    if (!odp_espi_exchange(s, write ? ODP_ESPI_CMD_SET_CONFIGURATION :
+                                     ODP_ESPI_CMD_GET_CONFIGURATION,
+                           data, write ? 6 : 2, deadline)) {
+        return false;
+    }
+    if (!write) {
+        *value = ldl_le_p(s->rx + 1);
+    }
+    return true;
+}
+
+static bool odp_espi_prepare(OdpESPIControllerState *s, int64_t deadline)
+{
+    uint32_t value;
+    unsigned supported;
+    bool ready = s->ready;
+
+    if (s->reset_needed) {
+        odp_espi_clear_vwires(s);
+        s->crc_enabled = false;
+        s->tx[0] = ODP_ESPI_WIRE_RESET;
+        s->tx[1] = ODP_ESPI_WIRE_RESET_ASSERTED;
+        s->tx[2] = ODP_ESPI_WIRE_RESET;
+        s->tx[3] = ODP_ESPI_WIRE_RESET_DEASSERTED;
+        if (!odp_espi_transmit(s, 4, false, deadline)) {
+            return false;
+        }
+        s->reset_needed = false;
+    }
+    if (!s->configured) {
+        if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_DEVICE_ID,
+                                    &value, false, deadline)) {
+            return false;
+        }
+        if ((value & ODP_ESPI_DEVICE_ID_VERSION_MASK) !=
+            ODP_ESPI_DEVICE_ID_VERSION) {
+            odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+            return false;
+        }
+        if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_GENERAL,
+                                    &value, false, deadline)) {
+            return false;
+        }
+        if (!(value & ODP_ESPI_GENERAL_CHANNEL0_SUPPORTED)) {
+            odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+            return false;
+        }
+        s->vwire_supported = value & ODP_ESPI_GENERAL_CHANNEL1_SUPPORTED;
+        value = (value | ODP_ESPI_GENERAL_CRC_ENABLE) &
+                ~ESPI_RESPONSE_MODIFIER;
+        if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_GENERAL,
+                                    &value, true, deadline)) {
+            return false;
+        }
+        s->crc_enabled = true;
+        if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_CH0,
+                                    &value, false, deadline)) {
+            return false;
+        }
+        supported = (value & ODP_ESPI_CH0_MAX_PAYLOAD_SUPPORTED_MASK) >>
+                    ODP_ESPI_CH0_MAX_PAYLOAD_SUPPORTED_SHIFT;
+
+        if (supported < ODP_ESPI_SIZE_64B_CODE ||
+            supported > ODP_ESPI_SIZE_256B_CODE) {
+            odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+            return false;
+        }
+        value &= ~(ODP_ESPI_CH0_MAX_PAYLOAD_SELECTED_MASK |
+                   ODP_ESPI_CH0_MAX_READ_REQUEST_MASK |
+                   ODP_ESPI_CH0_BUS_MASTER_ENABLE);
+        value |= ODP_ESPI_CH0_ENABLE |
+            (ODP_ESPI_SIZE_64B_CODE <<
+             ODP_ESPI_CH0_MAX_PAYLOAD_SELECTED_SHIFT) |
+            (ODP_ESPI_SIZE_64B_CODE << ODP_ESPI_CH0_MAX_READ_REQUEST_SHIFT);
+        if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_CH0,
+                                    &value, true, deadline)) {
+            return false;
+        }
+        if (s->vwire_supported) {
+            if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_CH1,
+                                        &value, false, deadline)) {
+                return false;
+            }
+            supported = 1 + ((value &
+                              ODP_ESPI_CH1_MAX_COUNT_SUPPORTED_MASK) >>
+                             ODP_ESPI_CH1_MAX_COUNT_SUPPORTED_SHIFT);
+            if (supported < ODP_ESPI_VWIRE_MIN_COUNT) {
+                odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+                return false;
+            }
+            s->vwire_limit = ODP_ESPI_VWIRE_MIN_COUNT;
+            value &= ~ODP_ESPI_CH1_MAX_COUNT_SELECTED_MASK;
+            value |= ODP_ESPI_CH1_ENABLE |
+                     ((s->vwire_limit - 1) <<
+                      ODP_ESPI_CH1_MAX_COUNT_SELECTED_SHIFT);
+            if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_CH1,
+                                        &value, true, deadline)) {
+                return false;
+            }
+        }
+        s->configured = true;
+    }
+    if (!s->ready) {
+        if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_CH0,
+                                    &value, false, deadline)) {
+            return false;
+        }
+        ready = (value & (ODP_ESPI_CH0_ENABLE | ODP_ESPI_CH0_READY)) ==
+            (ODP_ESPI_CH0_ENABLE | ODP_ESPI_CH0_READY);
+        if (s->vwire_supported) {
+            if (!odp_espi_configuration(s, ODP_ESPI_CONFIG_CH1,
+                                        &value, false, deadline)) {
+                return false;
+            }
+            s->vwire_ready =
+                (value & (ODP_ESPI_CH1_ENABLE | ODP_ESPI_CH1_READY)) ==
+                (ODP_ESPI_CH1_ENABLE | ODP_ESPI_CH1_READY);
+            ready &= s->vwire_ready;
+        }
+    }
+    if (ready && !s->ready) {
+        if (s->alert) {
+            s->alert = false;
+            if (!odp_espi_exchange(s, ODP_ESPI_CMD_GET_STATUS,
+                                   NULL, 0, deadline)) {
+                return false;
+            }
+        }
+        if (!odp_espi_drain_vwires(s, deadline)) {
+            return false;
+        }
+    }
+    s->ready = ready;
+    return s->ready;
+}
+
+static int odp_espi_can_receive(void *opaque)
+{
+    OdpESPIControllerState *state = opaque;
+
+    return sizeof(state->rx);
+}
+
+static void odp_espi_receive_vwires(OdpESPIControllerState *state)
+{
+    unsigned count = state->rx[1] + 1;
+    unsigned index;
+
+    for (index = 0; index < count; index++) {
+        uint8_t group = state->rx[2 + index * 2];
+        uint8_t value = state->rx[3 + index * 2];
+
+        if (group <= ODP_ESPI_VWIRE_IRQ_HIGH) {
+            unsigned irq = group * 128 + (value & ODP_ESPI_VWIRE_IRQ_MASK);
+
+            if (irq < ODP_ESPI_IRQ_COUNT) {
+                if (value & ODP_ESPI_VWIRE_IRQ_LEVEL) {
+                    state->irq_level |= 1U << irq;
+                } else {
+                    state->irq_level &= ~(1U << irq);
+                }
+                odp_espi_update_irq(state);
+            }
+        }
+    }
+}
+
+static void odp_espi_receive(void *opaque, const uint8_t *data, int length)
+{
+    OdpESPIControllerState *s = opaque;
+    int index;
+
+    for (index = 0; index < length; index++) {
+        uint8_t byte = data[index];
+
+        if (!s->receiving) {
+            if (byte == ODP_ESPI_WIRE_ALERT) {
+                s->alert = true;
+                qemu_cond_broadcast(&s->cond);
+                odp_espi_schedule_service(s);
+                continue;
+            }
+            if (byte != ODP_ESPI_WIRE_DATA || !s->pending ||
+                !s->expect_response || s->tx_pos != s->tx_size) {
+                goto malformed;
+            }
+            s->receiving = true;
+            continue;
+        }
+        if (!s->rx_size && byte == ODP_ESPI_RSP_WAIT_STATE) {
+            continue;
+        }
+        if (s->rx_size == sizeof(s->rx)) {
+            goto malformed;
+        }
+        s->rx[s->rx_size++] = byte;
+        if (s->rx_size == 1) {
+            if (byte == ODP_ESPI_RSP_NO_RESPONSE || (byte & 0xc0)) {
+                goto malformed;
+            }
+            switch (byte & 0x0f) {
+            case ODP_ESPI_RSP_ACCEPT:
+                if (s->command == ODP_ESPI_CMD_GET_CONFIGURATION) {
+                    s->rx_needed = 8;
+                } else if (s->command == ODP_ESPI_CMD_PUT_NP ||
+                           s->command == ODP_ESPI_CMD_GET_PC ||
+                           s->command == ODP_ESPI_CMD_GET_VWIRE) {
+                    s->rx_needed = 0;
+                } else {
+                    s->rx_needed = 4;
+                }
+                break;
+            case ODP_ESPI_RSP_DEFER:
+                if (s->command != ODP_ESPI_CMD_PUT_NP) {
+                    goto malformed;
+                }
+                s->rx_needed = 4;
+                break;
+            case ODP_ESPI_RSP_NON_FATAL_ERROR:
+            case ODP_ESPI_RSP_FATAL_ERROR:
+                s->rx_needed = 4;
+                break;
+            default:
+                goto malformed;
+            }
+        }
+        if (!s->rx_needed && s->command == ODP_ESPI_CMD_GET_VWIRE &&
+            s->rx_size == 2) {
+            if ((byte & ~ODP_ESPI_VWIRE_COUNT_MASK) ||
+                byte + 1 > s->vwire_limit) {
+                goto malformed;
+            }
+            s->rx_needed = 5 + 2 * (byte + 1);
+        }
+        if (!s->rx_needed && s->rx_size == 4) {
+            unsigned payload = lduw_be_p(s->rx + 2) &
+                               ODP_ESPI_PACKET_LENGTH_MASK;
+
+            if (s->rx[1] == ODP_ESPI_CYCLE_SUCCESS_DATA_ONLY) {
+                if (!payload || payload > ESPI_MAX_PAYLOAD) {
+                    goto malformed;
+                }
+            } else if (s->rx[1] == ODP_ESPI_CYCLE_UNSUCCESSFUL_ONLY) {
+                payload = 0;
+            } else {
+                goto malformed;
+            }
+            s->rx_needed = 7 + payload;
+        }
+        if (s->rx_size != s->rx_needed) {
+            continue;
+        }
+        if (s->crc_enabled && odp_espi_crc8(s->rx, s->rx_size)) {
+            odp_espi_disconnect(s, ESPI_ERROR_CRC);
+            return;
+        }
+        s->target_status = lduw_le_p(s->rx + s->rx_size - 3);
+        if ((s->rx[0] & 0x0f) == ODP_ESPI_RSP_FATAL_ERROR ||
+            (s->rx[0] & 0x0f) == ODP_ESPI_RSP_NON_FATAL_ERROR) {
+            goto malformed;
+        }
+        s->pending = false;
+        s->receiving = false;
+        if (s->command == ODP_ESPI_CMD_GET_VWIRE) {
+            odp_espi_receive_vwires(s);
+        }
+        if (s->target_status & ODP_ESPI_STATUS_VWIRE_AVAIL) {
+            odp_espi_schedule_service(s);
+        }
+        qemu_cond_broadcast(&s->cond);
+    }
+    return;
+
+malformed:
+    odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+}
+
+static bool odp_espi_drain_vwires(OdpESPIControllerState *state,
+                                  int64_t deadline)
+{
+    while (state->vwire_ready &&
+           (state->target_status & ODP_ESPI_STATUS_VWIRE_AVAIL)) {
+        if (odp_espi_now_ms() >= deadline) {
+            odp_espi_disconnect(state, ESPI_ERROR_TIMEOUT);
+            return false;
+        }
+        if (!odp_espi_exchange(state, ODP_ESPI_CMD_GET_VWIRE,
+                               NULL, 0, deadline)) {
+            return false;
+        }
+    }
+    return !state->failed;
+}
+
+static gboolean odp_espi_service(void *opaque)
+{
+    OdpESPIControllerState *s = opaque;
+    int64_t deadline = odp_espi_now_ms() + s->timeout_ms;
+
+    s->service_source = 0;
+    if (!s->connected) {
+        return G_SOURCE_REMOVE;
+    }
+    if (!s->busy) {
+        s->busy = true;
+        s->failed = false;
+        if (odp_espi_prepare(s, deadline) || s->vwire_ready) {
+            if (s->alert) {
+                s->alert = false;
+                odp_espi_exchange(s, ODP_ESPI_CMD_GET_STATUS,
+                                   NULL, 0, deadline);
+            }
+            if (!s->failed) {
+                odp_espi_drain_vwires(s, deadline);
+            }
+        }
+        s->busy = false;
+        qemu_cond_broadcast(&s->cond);
+    }
+    if (!s->busy && s->connected && !s->ready && !s->service_source) {
+        s->service_source = g_timeout_add(10, odp_espi_service, s);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void odp_espi_schedule_service(OdpESPIControllerState *s)
+{
+    if (!s->service_source && s->connected) {
+        s->service_source = g_idle_add(odp_espi_service, s);
+    }
+}
+
+static void odp_espi_event(void *opaque, QEMUChrEvent event)
+{
+    OdpESPIControllerState *s = opaque;
+
+    switch (event) {
+    case CHR_EVENT_OPENED:
+        s->connected = true;
+        s->ready = false;
+        s->configured = false;
+        s->reset_needed = true;
+        odp_espi_clear_vwires(s);
+        odp_espi_schedule_service(s);
+        break;
+    case CHR_EVENT_CLOSED:
+        s->connected = false;
+        odp_espi_cancel(s, ESPI_ERROR_LINK);
+        if (s->service_source) {
+            g_source_remove(s->service_source);
+            s->service_source = 0;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void odp_espi_unmap_window(OdpESPIWindow *window)
+{
+    if (window->mapped) {
+        memory_region_del_subregion(get_system_memory(), &window->iomem);
+        window->mapped = false;
+    }
+}
+
+static bool odp_espi_window_valid(OdpESPIWindow *window,
+                                  uint32_t base, uint32_t size)
+{
+    MemoryRegionSection section;
+
+    if (!size || (uint64_t)base + size > (1ULL << 32)) {
+        return false;
+    }
+
+    section = memory_region_find(get_system_memory(), base, size);
+    if (section.mr) {
+        memory_region_unref(section.mr);
+        return false;
+    }
+    return true;
+}
+
+static void odp_espi_map_window(OdpESPIWindow *window)
+{
+    memory_region_set_size(&window->iomem, window->size);
+    memory_region_add_subregion(get_system_memory(), window->base,
+                               &window->iomem);
+    window->mapped = true;
+}
+
+static MemTxResult odp_espi_access(OdpESPIWindow *window, hwaddr offset,
+                                   uint64_t *value, unsigned size, bool write)
+{
+    OdpESPIControllerState *s = window->controller;
+    int64_t deadline = odp_espi_now_ms() + s->timeout_ms;
+    uint8_t request[7 + 4];
+    unsigned index;
+    uint16_t free_bit = write ? ODP_ESPI_STATUS_PC_FREE :
+                               ODP_ESPI_STATUS_NP_FREE;
+    MemTxResult result = MEMTX_ERROR;
+
+    while (s->busy) {
+        if (!qemu_in_vcpu_thread() || !odp_espi_wait(s, deadline)) {
+            *value = UINT64_MAX;
+            return MEMTX_ERROR;
+        }
+    }
+    s->busy = true;
+    s->failed = false;
+    if (!s->connected) {
+        odp_espi_set_error(s, ESPI_ERROR_LINK);
+        goto out;
+    }
+    if (!window->enabled || offset + size > window->size ||
+        !odp_espi_prepare(s, deadline) ||
+        !odp_espi_drain_vwires(s, deadline)) {
+        goto out;
+    }
+    while (!(s->target_status & free_bit)) {
+        if (!odp_espi_exchange(s, ODP_ESPI_CMD_GET_STATUS, NULL, 0, deadline) ||
+            !odp_espi_drain_vwires(s, deadline) ||
+            (!(s->target_status & free_bit) && !odp_espi_wait(s, deadline))) {
+            goto out;
+        }
+    }
+    if (!write) {
+        s->tag = (s->tag + 1) & 0x0f;
+    }
+    request[0] = write ? ODP_ESPI_CYCLE_MEM_WRITE32 :
+                         ODP_ESPI_CYCLE_MEM_READ32;
+    stw_be_p(request + 1, (s->tag << 12) | size);
+    stl_be_p(request + 3, window->base + offset);
+    for (index = 0; write && index < size; index++) {
+        request[7 + index] = *value >> (index * 8);
+    }
+    if (!odp_espi_exchange(s, write ? ODP_ESPI_CMD_PUT_PC :
+                                     ODP_ESPI_CMD_PUT_NP,
+                           request, 7 + (write ? size : 0), deadline)) {
+        goto out;
+    }
+    if (write) {
+        result = MEMTX_OK;
+        goto out;
+    }
+    if ((s->rx[0] & 0x0f) == ODP_ESPI_RSP_DEFER) {
+        while (!(s->target_status & ODP_ESPI_STATUS_PC_AVAIL)) {
+            if (!odp_espi_exchange(s, ODP_ESPI_CMD_GET_STATUS,
+                                   NULL, 0, deadline) ||
+                !odp_espi_drain_vwires(s, deadline) ||
+                (!(s->target_status & ODP_ESPI_STATUS_PC_AVAIL) &&
+                 !odp_espi_wait(s, deadline))) {
+                goto out;
+            }
+        }
+        if (!odp_espi_exchange(s, ODP_ESPI_CMD_GET_PC, NULL, 0, deadline)) {
+            goto out;
+        }
+    }
+    if ((s->rx[2] >> ODP_ESPI_PACKET_TAG_SHIFT) != s->tag) {
+        odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+        goto out;
+    }
+    if (s->rx[1] == ODP_ESPI_CYCLE_UNSUCCESSFUL_ONLY) {
+        odp_espi_set_error(s, ESPI_ERROR_COMPLETION);
+        goto out;
+    }
+    if (s->rx_size != size + 7) {
+        odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+        goto out;
+    }
+    *value = 0;
+    for (index = 0; index < size; index++) {
+        *value |= (uint64_t)s->rx[4 + index] << (index * 8);
+    }
+    result = MEMTX_OK;
+
+out:
+    if (result == MEMTX_OK && !odp_espi_drain_vwires(s, deadline)) {
+        result = MEMTX_ERROR;
+    }
+    s->busy = false;
+    if (result != MEMTX_OK) {
+        *value = UINT64_MAX;
+    }
+    qemu_cond_broadcast(&s->cond);
+    if (s->alert || (s->target_status & ODP_ESPI_STATUS_VWIRE_AVAIL)) {
+        odp_espi_schedule_service(s);
+    }
+    return result;
+}
+
+static MemTxResult odp_espi_window_read(void *opaque, hwaddr offset,
+                                       uint64_t *value, unsigned size,
+                                       MemTxAttrs attrs)
+{
+    return odp_espi_access(opaque, offset, value, size, false);
+}
+
+static MemTxResult odp_espi_window_write(void *opaque, hwaddr offset,
+                                        uint64_t value, unsigned size,
+                                        MemTxAttrs attrs)
+{
+    return odp_espi_access(opaque, offset, &value, size, true);
+}
+
+static bool odp_espi_window_accepts(void *opaque, hwaddr offset,
+                                    unsigned size, bool write, MemTxAttrs attrs)
+{
+    OdpESPIWindow *window = opaque;
+    bool valid = size >= 1 && size <= 8 && !(offset & (size - 1));
+
+    if (window == &window->controller->windows[ESPI_DATA_WINDOW_COUNT]) {
+        hwaddr reg = offset % ODP_ESPI_CONTROL_STRIDE;
+
+        valid = valid && size == 4 &&
+            offset < ESPI_DATA_WINDOW_COUNT * ODP_ESPI_CONTROL_STRIDE &&
+                (reg == ESPI_CONTROL_STATUS ||
+                 reg == ESPI_CONTROL_DOORBELL ||
+                 reg == ESPI_CONTROL_IRQ_ACK);
+    }
+    return valid;
+}
+
+static const MemoryRegionOps odp_espi_window_ops = {
+    .read_with_attrs = odp_espi_window_read,
+    .write_with_attrs = odp_espi_window_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8,
+               .accepts = odp_espi_window_accepts },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void odp_espi_reset_hold(Object *obj, ResetType type)
+{
+    OdpESPIControllerState *s = ODP_ESPI_CONTROLLER(obj);
+    unsigned index;
+
+    if (s->busy) {
+        odp_espi_disconnect(s, ESPI_ERROR_PROTOCOL);
+    }
+    for (index = 0; index < ESPI_WINDOW_COUNT; index++) {
+        odp_espi_unmap_window(&s->windows[index]);
+    }
+    s->errors = 0;
+    odp_espi_clear_vwires(s);
+    s->ready = false;
+    s->configured = false;
+    s->reset_needed = true;
+    s->tag = 0;
+    s->target_status = 0;
+    s->alert = false;
+    for (index = 0; index < ESPI_WINDOW_COUNT; index++) {
+        OdpESPIWindow *window = &s->windows[index];
+
+        window->base = index == ESPI_DATA_WINDOW_COUNT ?
+                       ODP_ESPI_CONTROL_BASE :
+                       ODP_ESPI_SHARED_BASE + index * ODP_ESPI_SHARED_STRIDE;
+        window->size = ESPI_WINDOW_SIZE;
+        window->enabled = odp_espi_window_valid(window, window->base,
+                                                window->size);
+        if (window->enabled) {
+            odp_espi_map_window(window);
+        } else {
+            odp_espi_set_error(s, ESPI_ERROR_WINDOW);
+        }
+    }
+    odp_espi_schedule_service(s);
+}
+
+static void odp_espi_controller_init(Object *obj)
+{
+    OdpESPIControllerState *s = ODP_ESPI_CONTROLLER(obj);
+    unsigned index;
+
+    for (index = 0; index < ODP_ESPI_IRQ_COUNT; index++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[index]);
+    }
+    for (index = 0; index < ESPI_WINDOW_COUNT; index++) {
+        OdpESPIWindow *window = &s->windows[index];
+
+        window->controller = s;
+        memory_region_init_io(&window->iomem, obj, &odp_espi_window_ops,
+                              window, "odp-espi-window", ESPI_WINDOW_SIZE);
+        window->iomem.disable_reentrancy_guard = true;
+    }
+}
+
+static void odp_espi_controller_realize(DeviceState *dev, Error **errp)
+{
+    OdpESPIControllerState *s = ODP_ESPI_CONTROLLER(dev);
+
+    if (!s->timeout_ms || s->timeout_ms > INT_MAX) {
+        error_setg(errp, "eSPI timeout-ms must be between 1 and %d", INT_MAX);
+        return;
+    }
+    qemu_cond_init(&s->cond);
+    odp_espi_reset_hold(OBJECT(dev), RESET_TYPE_COLD);
+    qemu_chr_fe_set_handlers(&s->chr, odp_espi_can_receive, odp_espi_receive,
+                             odp_espi_event, NULL, s, NULL, true);
+}
+
+static void odp_espi_controller_unrealize(DeviceState *dev)
+{
+    OdpESPIControllerState *s = ODP_ESPI_CONTROLLER(dev);
+    unsigned index;
+
+    qemu_chr_fe_set_handlers(&s->chr, NULL, NULL, NULL, NULL, NULL,
+                             NULL, false);
+    if (s->service_source) {
+        g_source_remove(s->service_source);
+    }
+    if (s->write_watch) {
+        g_source_remove(s->write_watch);
+    }
+    for (index = 0; index < ESPI_WINDOW_COUNT; index++) {
+        odp_espi_unmap_window(&s->windows[index]);
+    }
+    qemu_cond_destroy(&s->cond);
+}
+
+static const Property odp_espi_controller_properties[] = {
+    DEFINE_PROP_CHR("chardev", OdpESPIControllerState, chr),
+    DEFINE_PROP_UINT32("timeout-ms", OdpESPIControllerState, timeout_ms, 1000),
+};
+
+static const VMStateDescription odp_espi_vmstate = {
+    .name = TYPE_ODP_ESPI_CONTROLLER,
+    .unmigratable = true,
+};
+
+static void odp_espi_controller_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    ResettableClass *rc = RESETTABLE_CLASS(oc);
+
+    dc->desc = "ODP socket-backed eSPI controller";
+    dc->realize = odp_espi_controller_realize;
+    dc->unrealize = odp_espi_controller_unrealize;
+    dc->vmsd = &odp_espi_vmstate;
+    dc->hotpluggable = false;
+    rc->phases.hold = odp_espi_reset_hold;
+    device_class_set_props(dc, odp_espi_controller_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo odp_espi_controller_info = {
+    .name          = TYPE_ODP_ESPI_CONTROLLER,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(OdpESPIControllerState),
+    .instance_init = odp_espi_controller_init,
+    .class_init    = odp_espi_controller_class_init,
+};
+
+static void odp_espi_controller_register_types(void)
+{
+    type_register_static(&odp_espi_controller_info);
+}
+
+type_init(odp_espi_controller_register_types)
diff --git a/hw/odp/espi-target.c b/hw/odp/espi-target.c
new file mode 100644
index 0000000000..fc3d4df4b1
--- /dev/null
+++ b/hw/odp/espi-target.c
@@ -0,0 +1,1074 @@
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "chardev/char-fe.h"
+#include "hw/irq.h"
+#include "hw/odp/espi-proto.h"
+#include "hw/odp/espi-target.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "migration/vmstate.h"
+
+#define ESPI_REG_CONTROL         0x00
+#define ESPI_REG_MAILBOX0_ADDR   0x04
+#define ESPI_REG_MAILBOX1_ADDR   0x08
+#define ESPI_REG_CONTROL_ADDR    0x0c
+#define ESPI_REG_MAILBOX_CONTROL 0x10
+#define ESPI_REG_MAILBOX_STRIDE  0x0c
+#define ESPI_REG_SIZE            0x1000
+#define ESPI_MAILBOX_COUNT       2
+#define ESPI_MAILBOX_SIZE        4096
+#define ESPI_MAX_PAYLOAD         64
+#define ESPI_MAILBOX_CONTROL_SIZE 0x1000
+#define ESPI_MAILBOX_CONTROL_STRIDE 0x20
+#define ESPI_MAILBOX_SHARED_STATUS 0x00
+#define ESPI_MAILBOX_DOORBELL      0x04
+#define ESPI_MAILBOX_IRQ_SET       0x08
+#define ESPI_MAILBOX_IRQ_ACK       0x0c
+
+#define ESPI_CONTROL_ENABLE     (1U << 0)
+#define ESPI_ERROR_CRC          (1U << 0)
+#define ESPI_ERROR_PROTOCOL     (1U << 1)
+#define ESPI_ERROR_ADDRESS      (1U << 2)
+#define ESPI_ERROR_PERMISSION   (1U << 3)
+#define ESPI_ERROR_LINK         (1U << 4)
+#define ESPI_ERROR_CONFIG       (1U << 5)
+#define ESPI_ERROR_ABORT        (1U << 6)
+#define ESPI_ERROR_LENGTH       (1U << 7)
+#define ESPI_ERROR_UNSUPPORTED  (1U << 8)
+#define ESPI_ERROR_BUSY         (1U << 9)
+#define ESPI_ERROR_TIMEOUT      (1U << 10)
+#define ESPI_CH0_RESET          (ODP_ESPI_CH0_ENABLE | (1U << 4) | \
+                                (1U << 8) | (1U << 12))
+#define ESPI_VWIRE_COUNT        ODP_ESPI_VWIRE_MIN_COUNT
+#define ESPI_VWIRE_QUEUE_SIZE   64
+#define ESPI_HOST_IRQ_MASK      ((1U << ESPI_MAILBOX_COUNT) - 1)
+#define ESPI_CH1_RESET          ((ESPI_VWIRE_COUNT - 1) << \
+                                ODP_ESPI_CH1_MAX_COUNT_SUPPORTED_SHIFT)
+#define ESPI_STATUS_FIXED_FREE  (ODP_ESPI_STATUS_VWIRE_FREE | (1U << 8))
+#define ESPI_GENERAL_SUPPORTED  (ODP_ESPI_GENERAL_CHANNEL0_SUPPORTED | \
+                                ODP_ESPI_GENERAL_CHANNEL1_SUPPORTED)
+#define ESPI_GENERAL_WRITABLE   (ODP_ESPI_GENERAL_CRC_ENABLE | \
+                                (1U << 28) | (0xfU << 12))
+#define ESPI_GENERAL_UNSUPPORTED ((1U << 30) | (3U << 26) | \
+                                  (1U << 23) | (7U << 20))
+
+typedef enum OdpESPITargetRxState {
+    ESPI_RX_KIND,
+    ESPI_RX_DATA,
+    ESPI_RX_RESET,
+} OdpESPITargetRxState;
+
+typedef struct OdpESPIMailbox {
+    MemoryRegion iomem;
+    uint8_t data[ESPI_MAILBOX_SIZE];
+    uint32_t base;
+    uint32_t shared_status;
+    bool doorbell;
+} OdpESPIMailbox;
+
+struct OdpESPITargetState {
+    SysBusDevice parent_obj;
+    CharBackend chr;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    OdpESPIMailbox mailboxes[ESPI_MAILBOX_COUNT];
+    uint32_t control;
+    uint32_t errors;
+    uint32_t general;
+    uint32_t channel;
+    uint32_t vwire_channel;
+    uint32_t host_irq;
+    uint32_t mailbox_control_base;
+    uint8_t vwire_queue[ESPI_VWIRE_QUEUE_SIZE][ODP_ESPI_VWIRE_GROUP_SIZE];
+    unsigned vwire_head;
+    unsigned vwire_count;
+    unsigned tx_vwire_count;
+    bool connected;
+    bool external_reset;
+    OdpESPITargetRxState rx_state;
+    uint8_t rx[ODP_ESPI_PACKET_LENGTH_MAX + 9];
+    unsigned rx_size;
+    unsigned rx_needed;
+    uint8_t tx[ESPI_MAX_PAYLOAD + 8];
+    unsigned tx_size;
+    unsigned tx_pos;
+    uint16_t config_address;
+    uint32_t config_value;
+    uint16_t reported_status;
+    uint16_t alerted_status;
+    guint write_watch;
+    QEMUTimer *timer;
+    uint32_t timeout_ms;
+};
+
+static void odp_espit_alert(OdpESPITargetState *s);
+
+static uint32_t odp_espit_irq_status(OdpESPITargetState *s)
+{
+    uint32_t status = 0;
+    unsigned index;
+
+    for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+        if (s->mailboxes[index].doorbell) {
+            status |= 1U << index;
+        }
+    }
+    return status;
+}
+
+static void odp_espit_update_irq(OdpESPITargetState *s)
+{
+    qemu_set_irq(s->irq, odp_espit_irq_status(s) != 0);
+}
+
+static void odp_espit_set_error(OdpESPITargetState *s, uint32_t error)
+{
+    s->errors |= error;
+}
+
+static uint8_t odp_espit_crc8(const uint8_t *data, unsigned length)
+{
+    uint8_t crc = ODP_ESPI_CRC8_INIT;
+    unsigned index, bit;
+
+    for (index = 0; index < length; index++) {
+        crc ^= data[index];
+        for (bit = 0; bit < 8; bit++) {
+            crc = (crc << 1) ^ ((crc & 0x80) ? ODP_ESPI_CRC8_POLYNOMIAL : 0);
+        }
+    }
+    return crc;
+}
+
+static bool odp_espit_pending(OdpESPITargetState *s)
+{
+    return s->rx_state != ESPI_RX_KIND || s->tx_size;
+}
+
+static void odp_espit_clear_io(OdpESPITargetState *s)
+{
+    if (s->write_watch) {
+        g_source_remove(s->write_watch);
+        s->write_watch = 0;
+    }
+    timer_del(s->timer);
+    s->rx_state = ESPI_RX_KIND;
+    s->rx_size = 0;
+    s->rx_needed = 0;
+    s->tx_size = 0;
+    s->tx_pos = 0;
+    s->vwire_head = 0;
+    s->vwire_count = 0;
+    s->tx_vwire_count = 0;
+    s->config_address = 0;
+    s->reported_status = ESPI_STATUS_FIXED_FREE;
+    s->alerted_status = ESPI_STATUS_FIXED_FREE;
+}
+
+static void odp_espit_disconnect(OdpESPITargetState *s, uint32_t error)
+{
+    odp_espit_set_error(s, error |
+                       (odp_espit_pending(s) ? ESPI_ERROR_ABORT : 0));
+    odp_espit_clear_io(s);
+    qemu_chr_fe_disconnect(&s->chr);
+}
+
+static void odp_espit_timeout(void *opaque)
+{
+    odp_espit_disconnect(opaque, ESPI_ERROR_TIMEOUT);
+}
+
+static void odp_espit_arm_timer(OdpESPITargetState *s)
+{
+    timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + s->timeout_ms);
+}
+
+static bool odp_espit_ready(OdpESPITargetState *s)
+{
+    return s->connected && !s->external_reset &&
+           (s->control & ESPI_CONTROL_ENABLE) &&
+           (s->channel & ODP_ESPI_CH0_ENABLE);
+}
+
+static uint32_t odp_espit_channel(OdpESPITargetState *s)
+{
+    return s->channel | (odp_espit_ready(s) ? ODP_ESPI_CH0_READY : 0);
+}
+
+static bool odp_espit_vwire_ready(OdpESPITargetState *state)
+{
+    return state->connected && !state->external_reset &&
+           (state->vwire_channel & ODP_ESPI_CH1_ENABLE);
+}
+
+static uint32_t odp_espit_vwire_channel(OdpESPITargetState *state)
+{
+    return state->vwire_channel |
+           (odp_espit_vwire_ready(state) ? ODP_ESPI_CH1_READY : 0);
+}
+
+static void odp_espit_queue_vwire(OdpESPITargetState *state, uint8_t index,
+                                  uint8_t value)
+{
+    unsigned tail;
+
+    if (!odp_espit_vwire_ready(state)) {
+        return;
+    }
+    if (state->vwire_count == ESPI_VWIRE_QUEUE_SIZE) {
+        odp_espit_disconnect(state, ESPI_ERROR_BUSY);
+        return;
+    }
+    tail = (state->vwire_head + state->vwire_count) % ESPI_VWIRE_QUEUE_SIZE;
+    state->vwire_queue[tail][0] = index;
+    state->vwire_queue[tail][1] = value;
+    state->vwire_count++;
+}
+
+static void odp_espit_host_irq(OdpESPITargetState *state, uint32_t pending)
+{
+    uint32_t previous = state->host_irq;
+    unsigned index;
+
+    state->host_irq = pending & ESPI_HOST_IRQ_MASK;
+    for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+        if ((previous ^ state->host_irq) & (1U << index)) {
+            odp_espit_queue_vwire(state, ODP_ESPI_VWIRE_IRQ_LOW,
+                                  index | ((state->host_irq & (1U << index)) ?
+                                           ODP_ESPI_VWIRE_IRQ_LEVEL : 0));
+        }
+    }
+}
+
+static void odp_espit_sync_vwires(OdpESPITargetState *state)
+{
+    unsigned index;
+
+    state->vwire_head = 0;
+    state->vwire_count = 0;
+    for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+        odp_espit_queue_vwire(state, ODP_ESPI_VWIRE_IRQ_LOW,
+                              index | ((state->host_irq &
+                                        (1U << index)) ?
+                                       ODP_ESPI_VWIRE_IRQ_LEVEL : 0));
+    }
+}
+
+static uint16_t odp_espit_bus_status(OdpESPITargetState *s)
+{
+    return ESPI_STATUS_FIXED_FREE |
+           (odp_espit_ready(s) ? ODP_ESPI_STATUS_PC_FREE |
+                                 ODP_ESPI_STATUS_NP_FREE : 0) |
+           (odp_espit_vwire_ready(s) && s->vwire_count > s->tx_vwire_count ?
+            ODP_ESPI_STATUS_VWIRE_AVAIL : 0);
+}
+
+static void odp_espit_reset_hold(Object *obj, ResetType type)
+{
+    OdpESPITargetState *s = ODP_ESPI_TARGET(obj);
+    bool aborted = odp_espit_pending(s);
+    unsigned index;
+
+    odp_espit_clear_io(s);
+    if (s->connected) {
+        qemu_chr_fe_disconnect(&s->chr);
+    }
+    s->control = 0;
+    s->errors = aborted ? ESPI_ERROR_ABORT : 0;
+    s->general = ESPI_GENERAL_SUPPORTED;
+    s->channel = ESPI_CH0_RESET;
+    s->vwire_channel = ESPI_CH1_RESET;
+    s->host_irq = 0;
+    s->mailbox_control_base = 0;
+    for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+        OdpESPIMailbox *mailbox = &s->mailboxes[index];
+
+        mailbox->base = 0;
+        mailbox->shared_status = 0;
+        mailbox->doorbell = false;
+        memset(mailbox->data, 0, sizeof(mailbox->data));
+    }
+    odp_espit_update_irq(s);
+}
+
+static gboolean odp_espit_writable(void *unused, GIOCondition condition,
+                                    void *opaque);
+
+static void odp_espit_flush(OdpESPITargetState *s)
+{
+    int written;
+
+    written = qemu_chr_fe_write(&s->chr, s->tx + s->tx_pos,
+                                s->tx_size - s->tx_pos);
+    if (written < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+        odp_espit_disconnect(s, ESPI_ERROR_LINK);
+        return;
+    }
+    if (written > 0) {
+        s->tx_pos += written;
+    }
+    if (s->tx_pos < s->tx_size) {
+        s->write_watch = qemu_chr_fe_add_watch(&s->chr, G_IO_OUT | G_IO_HUP,
+                                               odp_espit_writable, s);
+        if (!s->write_watch) {
+            odp_espit_disconnect(s, ESPI_ERROR_LINK);
+        }
+        return;
+    }
+    s->tx_size = 0;
+    s->tx_pos = 0;
+    timer_del(s->timer);
+    s->vwire_head = (s->vwire_head + s->tx_vwire_count) %
+                    ESPI_VWIRE_QUEUE_SIZE;
+    s->vwire_count -= s->tx_vwire_count;
+    s->tx_vwire_count = 0;
+    if (s->config_address == ODP_ESPI_CONFIG_GENERAL) {
+        s->general = s->config_value;
+    } else if (s->config_address == ODP_ESPI_CONFIG_CH0) {
+        s->channel = s->config_value;
+    } else if (s->config_address == ODP_ESPI_CONFIG_CH1) {
+        bool enabled = !(s->vwire_channel & ODP_ESPI_CH1_ENABLE) &&
+                       (s->config_value & ODP_ESPI_CH1_ENABLE);
+
+        s->vwire_channel = s->config_value;
+        if (enabled) {
+            odp_espit_sync_vwires(s);
+        }
+    }
+    s->config_address = 0;
+    odp_espit_update_irq(s);
+    odp_espit_alert(s);
+    qemu_chr_fe_accept_input(&s->chr);
+}
+
+static gboolean odp_espit_writable(void *unused, GIOCondition condition,
+                                    void *opaque)
+{
+    OdpESPITargetState *s = opaque;
+
+    s->write_watch = 0;
+    if (condition & G_IO_HUP) {
+        odp_espit_disconnect(s, ESPI_ERROR_LINK);
+    } else {
+        odp_espit_flush(s);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void odp_espit_alert(OdpESPITargetState *s)
+{
+    uint16_t status = odp_espit_bus_status(s);
+
+    if (!s->connected || s->external_reset || s->tx_size ||
+        s->rx_state != ESPI_RX_KIND ||
+        status == s->reported_status || status == s->alerted_status) {
+        return;
+    }
+    s->alerted_status = status;
+    s->tx[0] = ODP_ESPI_WIRE_ALERT;
+    s->tx_size = 1;
+    s->tx_pos = 0;
+    odp_espit_arm_timer(s);
+    odp_espit_flush(s);
+}
+
+static void odp_espit_reply(OdpESPITargetState *s, uint8_t response,
+                             const uint8_t *payload, unsigned length)
+{
+    uint16_t status = odp_espit_bus_status(s);
+
+    s->tx[0] = ODP_ESPI_WIRE_DATA;
+    s->tx[1] = response;
+    if (length) {
+        memcpy(s->tx + 2, payload, length);
+    }
+    stw_le_p(s->tx + 2 + length, status);
+    s->tx[4 + length] = odp_espit_crc8(s->tx + 1, length + 3);
+    s->tx_size = length + 5;
+    s->tx_pos = 0;
+    s->reported_status = status;
+    s->alerted_status = status;
+    odp_espit_arm_timer(s);
+    odp_espit_flush(s);
+}
+
+static void odp_espit_reject(OdpESPITargetState *s, uint32_t error)
+{
+    odp_espit_set_error(s, error);
+    odp_espit_reply(s, ODP_ESPI_RSP_FATAL_ERROR, NULL, 0);
+}
+
+static void odp_espit_configuration(OdpESPITargetState *s)
+{
+    uint16_t address = lduw_be_p(s->rx + 1) & 0x0ffc;
+    uint32_t value = 0;
+    uint8_t data[4];
+
+    if (s->rx[0] == ODP_ESPI_CMD_GET_CONFIGURATION) {
+        switch (address) {
+        case ODP_ESPI_CONFIG_DEVICE_ID:
+            value = ODP_ESPI_DEVICE_ID_VERSION;
+            break;
+        case ODP_ESPI_CONFIG_GENERAL:
+            value = s->general;
+            break;
+        case ODP_ESPI_CONFIG_CH0:
+            value = odp_espit_channel(s);
+            break;
+        case ODP_ESPI_CONFIG_CH1:
+            value = odp_espit_vwire_channel(s);
+            break;
+        }
+        stl_le_p(data, value);
+        odp_espit_reply(s, ODP_ESPI_RSP_ACCEPT, data, sizeof(data));
+        return;
+    }
+    value = ldl_le_p(s->rx + 3);
+    switch (address) {
+    case ODP_ESPI_CONFIG_GENERAL:
+        if (value & ESPI_GENERAL_UNSUPPORTED) {
+            odp_espit_reject(s, ESPI_ERROR_CONFIG);
+            return;
+        }
+        s->config_address = address;
+        s->config_value = ESPI_GENERAL_SUPPORTED |
+                          (value & ESPI_GENERAL_WRITABLE);
+        break;
+    case ODP_ESPI_CONFIG_CH0:
+        if ((value & ODP_ESPI_CH0_BUS_MASTER_ENABLE) ||
+            ((value & ODP_ESPI_CH0_MAX_PAYLOAD_SELECTED_MASK) >>
+             ODP_ESPI_CH0_MAX_PAYLOAD_SELECTED_SHIFT) !=
+             ODP_ESPI_SIZE_64B_CODE ||
+            ((value & ODP_ESPI_CH0_MAX_READ_REQUEST_MASK) >>
+             ODP_ESPI_CH0_MAX_READ_REQUEST_SHIFT) != ODP_ESPI_SIZE_64B_CODE) {
+            odp_espit_reject(s, ESPI_ERROR_CONFIG);
+            return;
+        }
+        s->config_address = address;
+        s->config_value = (ESPI_CH0_RESET & ~ODP_ESPI_CH0_ENABLE) |
+                          (value & ODP_ESPI_CH0_ENABLE);
+        break;
+    case ODP_ESPI_CONFIG_CH1:
+        if (((value & ODP_ESPI_CH1_MAX_COUNT_SELECTED_MASK) >>
+             ODP_ESPI_CH1_MAX_COUNT_SELECTED_SHIFT) >= ESPI_VWIRE_COUNT) {
+            odp_espit_reject(s, ESPI_ERROR_CONFIG);
+            return;
+        }
+        s->config_address = address;
+        s->config_value = ESPI_CH1_RESET |
+                          (value & (ODP_ESPI_CH1_ENABLE |
+                                    ODP_ESPI_CH1_MAX_COUNT_SELECTED_MASK));
+        break;
+    }
+    odp_espit_reply(s, ODP_ESPI_RSP_ACCEPT, NULL, 0);
+}
+
+static uint32_t odp_espit_control_read(OdpESPITargetState *state,
+                                      hwaddr offset)
+{
+    unsigned index = offset / ESPI_MAILBOX_CONTROL_STRIDE;
+    OdpESPIMailbox *mailbox;
+
+    if (index >= ESPI_MAILBOX_COUNT) {
+        return 0;
+    }
+    mailbox = &state->mailboxes[index];
+    switch (offset % ESPI_MAILBOX_CONTROL_STRIDE) {
+    case ESPI_MAILBOX_SHARED_STATUS:
+        return mailbox->shared_status;
+    case ESPI_MAILBOX_DOORBELL:
+        return mailbox->doorbell;
+    case ESPI_MAILBOX_IRQ_SET:
+    case ESPI_MAILBOX_IRQ_ACK:
+        return (state->host_irq >> index) & 1;
+    }
+    return 0;
+}
+
+static void odp_espit_control_write(OdpESPITargetState *state, hwaddr offset,
+                                    uint32_t value, bool host)
+{
+    unsigned index = offset / ESPI_MAILBOX_CONTROL_STRIDE;
+    uint32_t mask;
+    OdpESPIMailbox *mailbox;
+
+    if (index >= ESPI_MAILBOX_COUNT) {
+        return;
+    }
+    mask = 1U << index;
+    mailbox = &state->mailboxes[index];
+    switch (offset % ESPI_MAILBOX_CONTROL_STRIDE) {
+    case ESPI_MAILBOX_SHARED_STATUS:
+        mailbox->shared_status = value;
+        break;
+    case ESPI_MAILBOX_DOORBELL:
+        if (value & 1) {
+            mailbox->doorbell = host;
+        }
+        break;
+    case ESPI_MAILBOX_IRQ_SET:
+        if (!host && (value & 1)) {
+            odp_espit_host_irq(state, state->host_irq | mask);
+        }
+        break;
+    case ESPI_MAILBOX_IRQ_ACK:
+        if (value & 1) {
+            odp_espit_host_irq(state, state->host_irq & ~mask);
+        }
+        break;
+    }
+    odp_espit_update_irq(state);
+}
+
+static void odp_espit_memory_request(OdpESPITargetState *s)
+{
+    bool write = s->rx[1] == ODP_ESPI_CYCLE_MEM_WRITE32;
+    uint16_t tag_length = lduw_be_p(s->rx + 2);
+    unsigned length = tag_length & ODP_ESPI_PACKET_LENGTH_MASK;
+    uint32_t address = ldl_be_p(s->rx + 4);
+    OdpESPIMailbox *mailbox = NULL;
+    uint8_t completion[3 + ESPI_MAX_PAYLOAD];
+    unsigned index;
+    uint32_t offset, reg;
+
+    if (write != (s->rx[0] == ODP_ESPI_CMD_PUT_PC)) {
+        odp_espit_reject(s, ESPI_ERROR_PERMISSION | ESPI_ERROR_PROTOCOL);
+        return;
+    }
+    if (!odp_espit_ready(s)) {
+        odp_espit_reject(s, ESPI_ERROR_BUSY);
+        return;
+    }
+    if (!length || length > ESPI_MAX_PAYLOAD ||
+        (address & (ESPI_MAX_PAYLOAD - 1)) + length > ESPI_MAX_PAYLOAD) {
+        odp_espit_reject(s, ESPI_ERROR_LENGTH);
+        return;
+    }
+    if (address >= s->mailbox_control_base &&
+        (uint64_t)address < (uint64_t)s->mailbox_control_base +
+                            ESPI_MAILBOX_CONTROL_SIZE) {
+        offset = address - s->mailbox_control_base;
+        reg = offset % ESPI_MAILBOX_CONTROL_STRIDE;
+        if (length != 4 || (address & 3)) {
+            odp_espit_set_error(s, ESPI_ERROR_LENGTH);
+            goto unsuccessful;
+        }
+        if (offset >= ESPI_MAILBOX_COUNT * ESPI_MAILBOX_CONTROL_STRIDE ||
+            (reg != ESPI_MAILBOX_SHARED_STATUS &&
+             reg != ESPI_MAILBOX_DOORBELL && reg != ESPI_MAILBOX_IRQ_ACK)) {
+            odp_espit_set_error(s, ESPI_ERROR_ADDRESS);
+            goto unsuccessful;
+        }
+        if (write) {
+            odp_espit_control_write(s, offset, ldl_le_p(s->rx + 8), true);
+        } else {
+            completion[0] = ODP_ESPI_CYCLE_SUCCESS_DATA_ONLY;
+            stw_be_p(completion + 1, tag_length);
+            stl_le_p(completion + 3, odp_espit_control_read(s, offset));
+        }
+        odp_espit_reply(s, ODP_ESPI_RSP_ACCEPT, completion,
+                        write ? 0 : length + 3);
+        return;
+    }
+    for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+        OdpESPIMailbox *candidate = &s->mailboxes[index];
+
+        if (address >= candidate->base &&
+            (uint64_t)address < (uint64_t)candidate->base + ESPI_MAILBOX_SIZE) {
+            mailbox = candidate;
+            break;
+        }
+    }
+    if (!mailbox || (uint64_t)address + length >
+                    (uint64_t)mailbox->base + ESPI_MAILBOX_SIZE) {
+        odp_espit_set_error(s, ESPI_ERROR_ADDRESS);
+        goto unsuccessful;
+    }
+    offset = address - mailbox->base;
+    if (write) {
+        memcpy(mailbox->data + offset, s->rx + 8, length);
+    } else {
+        completion[0] = ODP_ESPI_CYCLE_SUCCESS_DATA_ONLY;
+        stw_be_p(completion + 1, tag_length);
+        memcpy(completion + 3, mailbox->data + offset, length);
+    }
+    odp_espit_reply(s, ODP_ESPI_RSP_ACCEPT, completion,
+                    write ? 0 : length + 3);
+    return;
+
+unsuccessful:
+    if (write) {
+        odp_espit_reply(s, ODP_ESPI_RSP_FATAL_ERROR, NULL, 0);
+    } else {
+        completion[0] = ODP_ESPI_CYCLE_UNSUCCESSFUL_ONLY;
+        stw_be_p(completion + 1, tag_length & 0xf000);
+        odp_espit_reply(s, ODP_ESPI_RSP_ACCEPT, completion, 3);
+    }
+}
+
+static void odp_espit_vwire_request(OdpESPITargetState *state)
+{
+    unsigned limit = 1 + ((state->vwire_channel &
+                          ODP_ESPI_CH1_MAX_COUNT_SELECTED_MASK) >>
+                         ODP_ESPI_CH1_MAX_COUNT_SELECTED_SHIFT);
+    unsigned count, index;
+    uint8_t payload[1 + ESPI_VWIRE_COUNT * ODP_ESPI_VWIRE_GROUP_SIZE];
+
+    if (!odp_espit_vwire_ready(state)) {
+        odp_espit_reject(state, ESPI_ERROR_BUSY);
+        return;
+    }
+    if (state->rx[0] == ODP_ESPI_CMD_PUT_VWIRE) {
+        count = 1 + (state->rx[1] & ODP_ESPI_VWIRE_COUNT_MASK);
+        if ((state->rx[1] & ~ODP_ESPI_VWIRE_COUNT_MASK) || count > limit) {
+            odp_espit_reject(state, ESPI_ERROR_LENGTH);
+            return;
+        }
+        odp_espit_reply(state, ODP_ESPI_RSP_ACCEPT, NULL, 0);
+        return;
+    }
+    if (!state->vwire_count) {
+        odp_espit_reply(state, ODP_ESPI_RSP_NON_FATAL_ERROR, NULL, 0);
+        return;
+    }
+    count = MIN(limit, state->vwire_count);
+    for (index = 0; index < count; index++) {
+        unsigned slot = (state->vwire_head + index) % ESPI_VWIRE_QUEUE_SIZE;
+        unsigned previous, transitions = 0;
+
+        for (previous = 0; previous < index; previous++) {
+            if (payload[1 + previous * 2] == state->vwire_queue[slot][0] &&
+                (state->vwire_queue[slot][0] != ODP_ESPI_VWIRE_IRQ_LOW ||
+                 (payload[2 + previous * 2] & ODP_ESPI_VWIRE_IRQ_MASK) ==
+                 (state->vwire_queue[slot][1] & ODP_ESPI_VWIRE_IRQ_MASK))) {
+                transitions++;
+            }
+        }
+        if (transitions == 2) {
+            break;
+        }
+        memcpy(payload + 1 + index * 2, state->vwire_queue[slot], 2);
+    }
+    state->tx_vwire_count = index;
+    payload[0] = index - 1;
+    odp_espit_reply(state, ODP_ESPI_RSP_ACCEPT, payload, 1 + index * 2);
+}
+
+static void odp_espit_command(OdpESPITargetState *s)
+{
+    if ((s->general & ODP_ESPI_GENERAL_CRC_ENABLE) &&
+        odp_espit_crc8(s->rx, s->rx_size)) {
+        odp_espit_disconnect(s, ESPI_ERROR_CRC);
+        return;
+    }
+    switch (s->rx[0]) {
+    case ODP_ESPI_CMD_GET_CONFIGURATION:
+    case ODP_ESPI_CMD_SET_CONFIGURATION:
+        odp_espit_configuration(s);
+        break;
+    case ODP_ESPI_CMD_GET_STATUS:
+        odp_espit_reply(s, ODP_ESPI_RSP_ACCEPT, NULL, 0);
+        break;
+    case ODP_ESPI_CMD_PUT_PC:
+    case ODP_ESPI_CMD_PUT_NP:
+        odp_espit_memory_request(s);
+        break;
+    case ODP_ESPI_CMD_GET_PC:
+        odp_espit_reject(s, ESPI_ERROR_PROTOCOL);
+        break;
+    case ODP_ESPI_CMD_PUT_VWIRE:
+    case ODP_ESPI_CMD_GET_VWIRE:
+        odp_espit_vwire_request(s);
+        break;
+    }
+}
+
+static void odp_espit_external_reset(OdpESPITargetState *s, bool asserted)
+{
+    bool abort_tx = s->tx_size != 0;
+    unsigned index;
+
+    if (asserted) {
+        odp_espit_set_error(s, abort_tx ? ESPI_ERROR_ABORT : 0);
+        odp_espit_clear_io(s);
+        s->general = ESPI_GENERAL_SUPPORTED;
+        s->channel = ESPI_CH0_RESET;
+        s->vwire_channel = ESPI_CH1_RESET;
+        for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+            s->mailboxes[index].doorbell = false;
+        }
+    }
+    s->external_reset = asserted;
+    odp_espit_update_irq(s);
+    if (abort_tx) {
+        odp_espit_disconnect(s, ESPI_ERROR_ABORT);
+    } else {
+        odp_espit_alert(s);
+    }
+}
+
+static int odp_espit_can_receive(void *opaque)
+{
+    OdpESPITargetState *s = opaque;
+
+    return s->tx_size ? 0 : sizeof(s->rx) - s->rx_size;
+}
+
+static void odp_espit_receive(void *opaque, const uint8_t *data, int size)
+{
+    OdpESPITargetState *s = opaque;
+    int index;
+
+    for (index = 0; index < size; index++) {
+        uint8_t byte = data[index];
+
+        if (!s->connected) {
+            return;
+        }
+        if (s->rx_state == ESPI_RX_KIND) {
+            if (byte == ODP_ESPI_WIRE_RESET) {
+                s->rx_state = ESPI_RX_RESET;
+            } else if (byte == ODP_ESPI_WIRE_DATA && !s->external_reset &&
+                       !s->tx_size) {
+                s->rx_state = ESPI_RX_DATA;
+                s->rx_size = 0;
+                s->rx_needed = 0;
+            } else {
+                odp_espit_disconnect(s, ESPI_ERROR_PROTOCOL);
+                return;
+            }
+            odp_espit_arm_timer(s);
+            continue;
+        }
+        if (s->rx_state == ESPI_RX_RESET) {
+            if (byte > ODP_ESPI_WIRE_RESET_ASSERTED) {
+                odp_espit_disconnect(s, ESPI_ERROR_PROTOCOL);
+                return;
+            }
+            s->rx_state = ESPI_RX_KIND;
+            timer_del(s->timer);
+            odp_espit_external_reset(s, byte == ODP_ESPI_WIRE_RESET_ASSERTED);
+            continue;
+        }
+        if (s->rx_size == sizeof(s->rx)) {
+            odp_espit_disconnect(s, ESPI_ERROR_LENGTH);
+            return;
+        }
+        s->rx[s->rx_size++] = byte;
+        if (s->rx_size == 1) {
+            switch (byte) {
+            case ODP_ESPI_CMD_GET_CONFIGURATION:
+                s->rx_needed = 4;
+                break;
+            case ODP_ESPI_CMD_SET_CONFIGURATION:
+                s->rx_needed = 8;
+                break;
+            case ODP_ESPI_CMD_GET_STATUS:
+            case ODP_ESPI_CMD_GET_PC:
+            case ODP_ESPI_CMD_GET_VWIRE:
+                s->rx_needed = 2;
+                break;
+            case ODP_ESPI_CMD_PUT_PC:
+            case ODP_ESPI_CMD_PUT_NP:
+            case ODP_ESPI_CMD_PUT_VWIRE:
+                break;
+            default:
+                odp_espit_disconnect(s, ESPI_ERROR_UNSUPPORTED);
+                return;
+            }
+        }
+        if (s->rx[0] == ODP_ESPI_CMD_PUT_VWIRE && s->rx_size == 2) {
+            s->rx_needed = 3 + 2 *
+                (1 + (s->rx[1] & ODP_ESPI_VWIRE_COUNT_MASK));
+        }
+        if (!s->rx_needed && s->rx_size == 4) {
+            unsigned length = lduw_be_p(s->rx + 2) &
+                              ODP_ESPI_PACKET_LENGTH_MASK;
+
+            if (s->rx[1] == ODP_ESPI_CYCLE_MEM_WRITE32) {
+                s->rx_needed = 9 + (length ? length :
+                                    ODP_ESPI_PACKET_LENGTH_MAX);
+            } else if (s->rx[1] == ODP_ESPI_CYCLE_MEM_READ32) {
+                s->rx_needed = 9;
+            } else {
+                odp_espit_disconnect(s, ESPI_ERROR_UNSUPPORTED);
+                return;
+            }
+        }
+        if (s->rx_needed && s->rx_size == s->rx_needed) {
+            s->rx_state = ESPI_RX_KIND;
+            timer_del(s->timer);
+            odp_espit_command(s);
+            s->rx_size = 0;
+            s->rx_needed = 0;
+        }
+    }
+}
+
+static void odp_espit_event(void *opaque, QEMUChrEvent event)
+{
+    OdpESPITargetState *s = opaque;
+
+    switch (event) {
+    case CHR_EVENT_OPENED:
+        odp_espit_clear_io(s);
+        s->connected = true;
+        s->external_reset = false;
+        s->general = ESPI_GENERAL_SUPPORTED;
+        s->channel = ESPI_CH0_RESET;
+        s->vwire_channel = ESPI_CH1_RESET;
+        odp_espit_alert(s);
+        break;
+    case CHR_EVENT_CLOSED:
+        odp_espit_set_error(s, ESPI_ERROR_LINK |
+                           (odp_espit_pending(s) ? ESPI_ERROR_ABORT : 0));
+        s->connected = false;
+        s->external_reset = false;
+        s->general = ESPI_GENERAL_SUPPORTED;
+        s->channel = ESPI_CH0_RESET;
+        s->vwire_channel = ESPI_CH1_RESET;
+        odp_espit_clear_io(s);
+        break;
+    default:
+        break;
+    }
+    odp_espit_update_irq(s);
+}
+
+static bool odp_espit_decode_valid(OdpESPITargetState *s)
+{
+    uint32_t bases[] = {
+        s->mailboxes[0].base,
+        s->mailboxes[1].base,
+        s->mailbox_control_base,
+    };
+    unsigned index, previous;
+
+    for (index = 0; index < ARRAY_SIZE(bases); index++) {
+        if (bases[index] & (ESPI_MAILBOX_SIZE - 1)) {
+            return false;
+        }
+        for (previous = 0; previous < index; previous++) {
+            if (bases[index] == bases[previous]) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static uint64_t odp_espit_reg_read(void *opaque, hwaddr offset, unsigned size)
+{
+    OdpESPITargetState *s = opaque;
+    unsigned index;
+
+    switch (offset) {
+    case ESPI_REG_CONTROL:
+        return s->control;
+    case ESPI_REG_MAILBOX0_ADDR:
+    case ESPI_REG_MAILBOX1_ADDR:
+        index = (offset - ESPI_REG_MAILBOX0_ADDR) / 4;
+        return s->mailboxes[index].base;
+    case ESPI_REG_CONTROL_ADDR:
+        return s->mailbox_control_base;
+    }
+    if (offset >= ESPI_REG_MAILBOX_CONTROL &&
+        offset < ESPI_REG_MAILBOX_CONTROL +
+                 ESPI_MAILBOX_COUNT * ESPI_REG_MAILBOX_STRIDE) {
+        offset -= ESPI_REG_MAILBOX_CONTROL;
+        index = offset / ESPI_REG_MAILBOX_STRIDE;
+        return odp_espit_control_read(s,
+                   index * ESPI_MAILBOX_CONTROL_STRIDE +
+                   offset % ESPI_REG_MAILBOX_STRIDE);
+    }
+    return 0;
+}
+
+static void odp_espit_reg_write(void *opaque, hwaddr offset, uint64_t value,
+                                unsigned size)
+{
+    OdpESPITargetState *s = opaque;
+    unsigned index;
+
+    switch (offset) {
+    case ESPI_REG_CONTROL:
+        value &= ESPI_CONTROL_ENABLE;
+        if (value && !odp_espit_decode_valid(s)) {
+            odp_espit_set_error(s, ESPI_ERROR_CONFIG);
+            return;
+        }
+        s->control = value;
+        odp_espit_alert(s);
+        return;
+    case ESPI_REG_MAILBOX0_ADDR:
+    case ESPI_REG_MAILBOX1_ADDR:
+    case ESPI_REG_CONTROL_ADDR:
+        if (s->control & ESPI_CONTROL_ENABLE) {
+            odp_espit_set_error(s, ESPI_ERROR_CONFIG);
+        } else if (offset == ESPI_REG_CONTROL_ADDR) {
+            s->mailbox_control_base = value;
+        } else {
+            index = (offset - ESPI_REG_MAILBOX0_ADDR) / 4;
+            s->mailboxes[index].base = value;
+        }
+        return;
+    }
+    if (offset >= ESPI_REG_MAILBOX_CONTROL &&
+        offset < ESPI_REG_MAILBOX_CONTROL +
+                 ESPI_MAILBOX_COUNT * ESPI_REG_MAILBOX_STRIDE) {
+        offset -= ESPI_REG_MAILBOX_CONTROL;
+        index = offset / ESPI_REG_MAILBOX_STRIDE;
+        odp_espit_control_write(s, index * ESPI_MAILBOX_CONTROL_STRIDE +
+                                offset % ESPI_REG_MAILBOX_STRIDE,
+                               value, false);
+        odp_espit_alert(s);
+    }
+}
+
+static bool odp_espit_reg_accepts(void *opaque, hwaddr offset, unsigned size,
+                                  bool write, MemTxAttrs attrs)
+{
+    if (size != 4 || (offset & 3)) {
+        return false;
+    }
+    return true;
+}
+
+static const MemoryRegionOps odp_espit_reg_ops = {
+    .read = odp_espit_reg_read,
+    .write = odp_espit_reg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4,
+               .accepts = odp_espit_reg_accepts },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t odp_espit_memory_read(void *opaque, hwaddr offset,
+                                     unsigned size)
+{
+    OdpESPIMailbox *mailbox = opaque;
+    uint64_t value = 0;
+    unsigned index;
+
+    for (index = 0; index < size; index++) {
+        value |= (uint64_t)mailbox->data[offset + index] << (index * 8);
+    }
+    return value;
+}
+
+static void odp_espit_memory_write(void *opaque, hwaddr offset, uint64_t value,
+                                   unsigned size)
+{
+    OdpESPIMailbox *mailbox = opaque;
+    unsigned index;
+
+    for (index = 0; index < size; index++) {
+        mailbox->data[offset + index] = value >> (index * 8);
+    }
+}
+
+static bool odp_espit_memory_accepts(void *opaque, hwaddr offset,
+                                     unsigned size, bool write,
+                                     MemTxAttrs attrs)
+{
+    if (size < 1 || size > 4 || (offset & (size - 1))) {
+        return false;
+    }
+    return true;
+}
+
+static const MemoryRegionOps odp_espit_memory_ops = {
+    .read = odp_espit_memory_read,
+    .write = odp_espit_memory_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4,
+               .accepts = odp_espit_memory_accepts },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void odp_espi_target_init(Object *obj)
+{
+    OdpESPITargetState *s = ODP_ESPI_TARGET(obj);
+    SysBusDevice *busdev = SYS_BUS_DEVICE(obj);
+    unsigned index;
+
+    memory_region_init_io(&s->iomem, obj, &odp_espit_reg_ops, s,
+                          TYPE_ODP_ESPI_TARGET, ESPI_REG_SIZE);
+    sysbus_init_mmio(busdev, &s->iomem);
+    sysbus_init_irq(busdev, &s->irq);
+    for (index = 0; index < ESPI_MAILBOX_COUNT; index++) {
+        OdpESPIMailbox *mailbox = &s->mailboxes[index];
+
+        memory_region_init_io(&mailbox->iomem, obj, &odp_espit_memory_ops,
+                              mailbox, "odp-espi-mailbox", ESPI_MAILBOX_SIZE);
+        sysbus_init_mmio(busdev, &mailbox->iomem);
+    }
+}
+
+static void odp_espi_target_realize(DeviceState *dev, Error **errp)
+{
+    OdpESPITargetState *s = ODP_ESPI_TARGET(dev);
+
+    if (!s->timeout_ms || s->timeout_ms > INT_MAX) {
+        error_setg(errp, "eSPI timeout-ms must be between 1 and %d", INT_MAX);
+        return;
+    }
+    s->timer = timer_new_ms(QEMU_CLOCK_REALTIME, odp_espit_timeout, s);
+    odp_espit_reset_hold(OBJECT(dev), RESET_TYPE_COLD);
+    qemu_chr_fe_set_handlers(&s->chr, odp_espit_can_receive, odp_espit_receive,
+                             odp_espit_event, NULL, s, NULL, true);
+}
+
+static void odp_espi_target_unrealize(DeviceState *dev)
+{
+    OdpESPITargetState *s = ODP_ESPI_TARGET(dev);
+
+    qemu_chr_fe_set_handlers(&s->chr, NULL, NULL, NULL, NULL, NULL,
+                             NULL, false);
+    odp_espit_clear_io(s);
+    qemu_set_irq(s->irq, 0);
+    timer_free(s->timer);
+}
+
+static const Property odp_espi_target_properties[] = {
+    DEFINE_PROP_CHR("chardev", OdpESPITargetState, chr),
+    DEFINE_PROP_UINT32("timeout-ms", OdpESPITargetState, timeout_ms, 1000),
+};
+
+static const VMStateDescription odp_espit_vmstate = {
+    .name = TYPE_ODP_ESPI_TARGET,
+    .unmigratable = true,
+};
+
+static void odp_espi_target_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    ResettableClass *rc = RESETTABLE_CLASS(oc);
+
+    dc->desc = "ODP socket-backed eSPI target";
+    dc->realize = odp_espi_target_realize;
+    dc->unrealize = odp_espi_target_unrealize;
+    dc->vmsd = &odp_espit_vmstate;
+    dc->hotpluggable = false;
+    rc->phases.hold = odp_espit_reset_hold;
+    device_class_set_props(dc, odp_espi_target_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo odp_espi_target_info = {
+    .name          = TYPE_ODP_ESPI_TARGET,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(OdpESPITargetState),
+    .instance_init = odp_espi_target_init,
+    .class_init    = odp_espi_target_class_init,
+};
+
+static void odp_espi_target_register_types(void)
+{
+    type_register_static(&odp_espi_target_info);
+}
+
+type_init(odp_espi_target_register_types)
